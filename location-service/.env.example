# Location Service runtime configuration (all optional; defaults shown).

# SQLite catalog built by `python -m location_service.ingest build`.
LOCATION_CATALOG_PATH=/app/data/processed/mars/location/location_catalog.sqlite

# Seed catalog fallback (mission POIs + Bradbury Landing, no Gazetteer).
LOCATION_SEED_CATALOG_PATH=/app/data/seed/location_catalog_seed.sqlite

# Directory with curated YAML (regions, column mappings, aliases).
LOCATION_CONFIG_DIR=/app/config

# Only supported value today; the field exists so future bodies (e.g. moon) can plug in.
LOCATION_DEFAULT_BODY=mars

# Fuzzy match threshold (0..1) used by search/resolve ranking.
LOCATION_FUZZY_MIN_SCORE=0.60

# Score gap below which the top candidates are reported as ambiguous.
LOCATION_AMBIGUITY_GAP=0.05

# Hard cap on list/search page sizes.
LOCATION_MAX_LIMIT=50

# Enables POST /v1/admin/reload (catalog hot reload). Keep false in production.
LOCATION_ADMIN_ENABLED=false

# If false the service starts without a catalog and /v1 returns 503
# CATALOG_UNAVAILABLE. Default true: missing catalog aborts startup with the
# exact ingestion command to run.
LOCATION_CATALOG_REQUIRED=true

# Uvicorn/logging.
LOG_LEVEL=INFO
PORT=8001
