# Risk Assessment Service runtime configuration (all optional; defaults shown).

# Upstream datasource mode for BOTH MS4 terrain and MS3 raster:
#   synthetic  - deterministic in-process fakes (dev/tests, no upstreams needed)
#   http       - call MS4 (RISK_TERRAIN_BASE_URL) and MS3 (RISK_RASTER_BASE_URL)
#   unavailable - every upstream read fails -> factors report available:false,
#                 /health reports degraded
RISK_DATASOURCE_MODE=synthetic

# Upstream base URLs (mode=http only).
RISK_RASTER_BASE_URL=http://localhost:8003
RISK_TERRAIN_BASE_URL=http://localhost:8004

# Upstream call timeout (seconds) and retries per call.
RISK_UPSTREAM_TIMEOUT_S=60.0
RISK_UPSTREAM_RETRIES=2

# Environmental climatology catalog (SQLite, built by `python -m app.ingest`).
# Primary: processed catalog; the seed copy under data/seed is the fallback.
# If neither exists the temperature/radiation factors report available:false.
RISK_CATALOG_PATH=/app/data/processed/mars/risk/risk_catalog.sqlite
RISK_SEED_CATALOG_PATH=/app/data/seed/risk_catalog_seed.sqlite

# Directory with curated YAML (vehicle profiles, thresholds, weights, column maps).
RISK_CONFIG_DIR=/app/config

# Reference sol for environmental profiles; nearest available sol per dataset
# is selected and echoed in responses (delivered sols: 1360, 2140, 3290, 4710).
RISK_DEFAULT_SOL=1360

# Default vehicle profile id (config/vehicle_profiles.yaml).
RISK_DEFAULT_VEHICLE_PROFILE=baseline_mars_rover

# Request protection caps.
RISK_MAX_PATH_POINTS=1000
RISK_MAX_SAMPLES=1000
RISK_MAX_AREA_CELLS=250000

# Default path sampling step (m); matches the ~90 m rejilla grid.
RISK_SAMPLING_STEP_M=90.0

# Mars sphere radius used by distance/path math (IAU_2015:49900).
RISK_PLANET_RADIUS_M=3396190.0

# Uvicorn/logging.
RISK_LOG_LEVEL=INFO
PORT=8005
