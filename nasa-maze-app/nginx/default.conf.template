server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  resolver 127.0.0.11 valid=30s;

  location /api/ {
    set $core_upstream ${CORE_UPSTREAM};
    proxy_pass $core_upstream;
    proxy_set_header Host $host;
    proxy_read_timeout 180s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
